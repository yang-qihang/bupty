#!/usr/bin/env bash
# bin/bupty —— bupty 入口。定位安装目录、加载库并进入 TUI。
set -euo pipefail

# 确保 UTF-8 locale：C/POSIX locale 下中文宽度会按字节计导致界面错位。
case "${LC_ALL:-${LC_CTYPE:-${LANG:-C}}}" in
  C|POSIX|C.*|POSIX.*) export LC_ALL=C.UTF-8 ;;
esac

# 定位仓库根（bin/ 的上一级）。
_BUPTY_BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BUPTY_HOME="$(cd "${_BUPTY_BIN_DIR}/.." && pwd)"
export BUPTY_HOME

# 后台模式：不进入 TUI，循环拉取作业并对「紧急 DDL」弹窗通知。
if [[ "${1:-}" == "--background" ]]; then
  # shellcheck disable=SC1090
  source "${BUPTY_HOME}/lib/core.sh"
  # shellcheck disable=SC1090
  source "${BUPTY_HOME}/lib/http.sh"
  # shellcheck disable=SC1090
  source "${BUPTY_HOME}/lib/session.sh"
  # shellcheck disable=SC1090
  source "${BUPTY_HOME}/lib/creds.sh"
  # shellcheck disable=SC1090
  source "${BUPTY_HOME}/lib/ucloud.sh"
  # shellcheck disable=SC1090
  source "${BUPTY_HOME}/lib/settings.sh"
  # shellcheck disable=SC1090
  source "${BUPTY_HOME}/lib/booking.sh"
  # shellcheck disable=SC1090
  source "${BUPTY_HOME}/lib/background.sh"
  background_run
  exit $?
fi

# shellcheck disable=SC1090
source "${BUPTY_HOME}/tui.sh"

tui_main "$@"
